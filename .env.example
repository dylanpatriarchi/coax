# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# The LLM block below is read by src/llm/resolve.ts (the only module that reads
# secrets); COAX_I_AM_AUTHORIZED gates the responsible-use check and the last
# block is terminal/diagnostic. Values are trimmed and a blank value means
# "not configured" — leave them empty to stay deterministic.

# --- LLM provider used by the judge oracles and the adaptive attacker (optional) ---
# COAX runs fully offline without these: the oracles keep their deterministic
# pattern path and only the adaptive attacker requires a live model.
# Provider resolution, in order: COAX_PROVIDER wins; else it is inferred from
# COAX_MODEL (claude*/anthropic* -> anthropic, gpt-*/o[1-9]*/text-*/chatgpt* ->
# openai, an id containing ':' -> ollama); else ANTHROPIC_API_KEY; else
# OPENAI_API_KEY; else ollama on localhost. `none` disables live models entirely.
# COAX_PROVIDER=anthropic|openai|ollama|none

# Anthropic (Messages API). Model default when COAX_MODEL is unset: claude-opus-5.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Any OpenAI-compatible /chat/completions endpoint (OpenAI, Azure, vLLM,
# llama.cpp, Ollama's /v1). A non-OpenAI base URL may omit the key.
# Model default when COAX_MODEL is unset: gpt-4o-mini.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama — the fallback when nothing above is configured.
# Model default when COAX_MODEL is unset: qwen3.5:0.8b.
# OLLAMA_BASE_URL=http://localhost:11434

# Model id for the selected provider. There is no single global default: each
# provider falls back to its own id above, so with nothing configured at all the
# effective model is Ollama's qwen3.5:0.8b.
# COAX_MODEL=claude-opus-5

# --- Cost / rate-limit guards for any LLM calls ---
# Both are enforced by CallBudget; USD is charged per call from the per-model
# price table in src/llm/pricing.ts. Unset defaults: 200 calls, and NO USD
# ceiling (Number.POSITIVE_INFINITY) — the 1.00 below is a recommendation, not
# the built-in default. Local models are priced at zero; an unrecognised model
# id is charged at the most expensive tier so the guard stops early.
COAX_MAX_LLM_CALLS=200
COAX_MAX_USD=1.00
# COAX_LLM_TIMEOUT_MS=60000

# --- Offline kill switch ---
# 1/true/yes/on: no model is resolved and no network LLM client can be built —
# including a local Ollama one. CI sets this so scans stay fully deterministic.
# COAX_OFFLINE=1

# --- Responsible use ---
# Required to run against any non-localhost target; equivalent to the
# --i-am-authorized flag. Truthy spellings: true/1/yes/on (anything else,
# including "false", is a refusal). See README "Threat model & responsible use".
COAX_I_AM_AUTHORIZED=false

# --- Terminal / diagnostics (read by the CLI, not by resolve.ts) ---
# COAX_DEBUG: any non-empty value prints the stack behind an unexpected error.
# Note this one is plain truthiness — COAX_DEBUG=0 still enables it.
# COAX_DEBUG=1
# NO_COLOR / FORCE_COLOR / TERM: standard colour controls. --color / --no-color
# beat FORCE_COLOR, which beats NO_COLOR (presence alone disables), which beats
# TERM=dumb, which beats stderr TTY detection.
# NO_COLOR=1
