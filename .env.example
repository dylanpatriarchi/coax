# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Every variable below is read by src/llm/resolve.ts (the only module that reads
# secrets) except COAX_I_AM_AUTHORIZED, which gates the responsible-use check.
# Blank values mean "not configured" — leave them empty to stay deterministic.

# --- LLM provider used by the judge oracles and the adaptive attacker (optional) ---
# COAX runs fully offline without these: the oracles keep their deterministic
# pattern path and only the adaptive attacker requires a live model.
# Provider is inferred from whichever key is set and from COAX_MODEL; set
# COAX_PROVIDER to force it. `none` disables live models entirely.
# COAX_PROVIDER=anthropic|openai|ollama|none

# Anthropic (Messages API). Default model: claude-opus-5.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Any OpenAI-compatible /chat/completions endpoint (OpenAI, Azure, vLLM,
# llama.cpp, Ollama's /v1). A non-OpenAI base URL may omit the key.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama — the fallback when nothing above is configured.
# OLLAMA_BASE_URL=http://localhost:11434

# Model id for the selected provider (e.g. claude-opus-5, gpt-4o-mini, qwen3.5:0.8b).
# COAX_MODEL=claude-opus-5

# --- Cost / rate-limit guards for any LLM calls ---
# Both are enforced by CallBudget; USD is charged per call from the per-model
# price table in src/llm/pricing.ts.
COAX_MAX_LLM_CALLS=200
COAX_MAX_USD=1.00
# COAX_LLM_TIMEOUT_MS=60000

# --- Offline kill switch ---
# 1/true/yes/on: no model is resolved and no network LLM client can be built.
# CI sets this so scans stay fully deterministic.
# COAX_OFFLINE=1

# --- Responsible use ---
# Required to run against any non-localhost target. See README "Responsible use".
COAX_I_AM_AUTHORIZED=false
